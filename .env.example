# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (optional in development - fallback in-memory/persistence store is built-in)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile CAPTCHA (Skipped for now - deferred to later; pass-through active)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Performance & Mapping APIs (optional in development - mock providers enabled when missing)
PAGESPEED_API_KEY=""
GOOGLE_MAPS_API_KEY=""

